# =========================================================
# Road Sense monorepo .gitignore
# =========================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
*.pem
secrets/
/secrets/*

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# ---------- Django ----------
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ---------- Celery ----------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ---------- ML artifacts (live in Supabase Storage, never in git) ----------
*.pkl
*.joblib
ml_models/
**/outputs/**
!**/outputs/**/
!**/outputs/**/.gitkeep

# ---------- Node / Next.js ----------
node_modules/
.pnp
.pnp.js
.next/
out/
build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

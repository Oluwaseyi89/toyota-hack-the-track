# Backend (Django on Render) base URL, no trailing slash
NEXT_PUBLIC_API_URL=https://<your-backend-service>.onrender.com

# Backend WebSocket base (the app appends /telemetry/). Must point at the
# backend directly: Vercel does not proxy WebSockets. Optional: if unset it is
# derived from NEXT_PUBLIC_API_URL (https -> wss, + /ws).
NEXT_PUBLIC_WEBSOCKET_URL=wss://<your-backend-service>.onrender.com/ws

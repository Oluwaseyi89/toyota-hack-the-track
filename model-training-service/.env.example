# Only needed when running training outside Kaggle (on Kaggle, the notebook
# reads these from Kaggle Secrets). Never commit real values.

# Folder containing <track>_pit_data.csv, <track>_race_data.csv, <track>_weather_data.csv
ROAD_SENSE_DATA_DIR=./data
ROAD_SENSE_OUTPUT_DIR=./outputs

# Supabase Storage (only for --upload). Use the service_role / secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-or-secret-key>
SUPABASE_MODELS_BUCKET=road-sense-models
SUPABASE_MODELS_PREFIX=models

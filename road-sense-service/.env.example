# Copy to .env for local development. On Render, set these as environment
# variables on the single web service. No Redis is needed: background jobs
# run inside the web process, so run exactly ONE instance.

# --- Django ---
DJANGO_DEBUG=false
IS_PRODUCTION=true
DJANGO_SECRET_KEY=generate-a-long-random-string
# Render adds RENDER_EXTERNAL_HOSTNAME automatically; list any extra hosts here
DJANGO_ALLOWED_HOSTS=road-sense-service.onrender.com

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Session pooler" connection string (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL_REQUIRE=true
DB_CONN_MAX_AGE=60
# Local example:
# DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db_name>
# DB_SSL_REQUIRE=false

# --- Frontend origins (Vercel) ---
CORS_ALLOWED_ORIGINS=https://road-sense-app.vercel.app
# Optional, for Vercel preview deployments of THIS project only:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://road-sense-app(-[a-z0-9-]+)?\.vercel\.app$
# Default to CORS_ALLOWED_ORIGINS when unset:
# CSRF_TRUSTED_ORIGINS=https://road-sense-app.vercel.app
# WEBSOCKET_ALLOWED_ORIGINS=https://road-sense-app.vercel.app

# --- ML models ---
# ML_MODELS_DIR=/opt/render/project/src/ml_models

# --- Background jobs (in-process) ---
BACKGROUND_JOBS_ENABLED=true
# Seconds between runs; any job can be overridden, e.g.:
# JOB_INTERVAL_RACE_SIMULATION=30
# JOB_INTERVAL_STRATEGY_PREDICTIONS=30
# JOB_INTERVAL_ALERT_CONDITIONS=45
# JOB_INTERVAL_DATA_RETENTION=3600

# --- Simulated race feed (rows flagged is_simulated) ---
RACE_SIMULATION_ENABLED=true
SIMULATION_VEHICLE_COUNT=10
SIMULATION_RACE_LAPS=40

# --- Data retention ---
TELEMETRY_RETENTION_HOURS=168
HISTORY_RETENTION_HOURS=48
ALERT_RETENTION_DAYS=7
STALE_ALERT_HOURS=3
ALERT_DEDUP_MINUTES=30

# --- Race assumptions (results using these are flagged is_simulated) ---
# ASSUME_FUEL_TANK_LITERS=50
# ASSUME_FUEL_PER_LAP_LITERS=2.4
# ASSUME_PIT_LOSS_SECONDS=30
# ASSUME_TIRE_MAX_STINT_LAPS=25
